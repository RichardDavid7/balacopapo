{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Balacopapo Utilidades",
  "version": "0.1.0",
  "identifier": "io.github.richarddavid7.balacopapo.utilities",
  "build": {
    "frontendDist": "../splash"
