{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões base para o launcher local e para a instância Balacopapo remota configurada pelo usuário.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://*", "http://*"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "notification:default",
    "opener:default",
    "autostart:default",
    "updater:default",
    "deep-link:default"
  ]
}
